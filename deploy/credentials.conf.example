[Service]
LoadCredential=OPENAI_API_KEY:/etc/log-analyzer/credentials/openai_api_key
LoadCredential=ES_API_KEY:/etc/log-analyzer/credentials/es_api_key

# For Elasticsearch basic authentication, remove the ES_API_KEY line above and
# use both lines below.
# LoadCredential=ES_USERNAME:/etc/log-analyzer/credentials/es_username
# LoadCredential=ES_PASSWORD:/etc/log-analyzer/credentials/es_password

# For NVIDIA NIM, replace the OPENAI_API_KEY line above with:
# LoadCredential=NVIDIA_API_KEY:/etc/log-analyzer/credentials/nvidia_api_key
