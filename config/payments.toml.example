# 실행: python -m log_analyzer run --config config/payments.toml
# orders 설정과 입력, Git, 잠금, 상태 DB, 결과 디렉터리를 분리합니다.
[run]
lock_file = "state/payments/run.lock"
batch_size = 500
max_concurrency = 2
ingestion_delay_seconds = 0
severities = ["ERROR", "FATAL"]

[error_source]
type = "file"
name = "payments-file-logs"
path = "input/payments/application.log"
service = "payments"
encoding = "utf-8"
timestamp_timezone = "+09:00"
filter_time_window = false

[analysis]
language = "java"
source_context_lines = 75

[services.payments]
repository = "repos/payments.git"
branch = "main"
source_roots = ["src/main/java"]
application_packages = ["com.example.payment"]
diff_history = 5

[openai]
provider = "onprem"
base_url = "https://llm.internal:8000/v1"
model = "replace-with-internal-model-id"
auth_required = true
api_key_secret = "LLM_API_KEY"
structured_output = "json_schema"
timeout_seconds = 120
max_output_tokens = 4096
# tls_ca = "config/certs/internal-ca.pem"

[state]
path = "state/payments/state.db"

[report]
directory = "reports/payments"
retention_days = 30
